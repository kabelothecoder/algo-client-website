# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
# The anon key is safe to expose: RLS is what protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── AI intake assistant (optional) ──────────────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint. Defaults below are Gemini's
# free tier, reached through its OpenAI compatibility layer.
# Get a key at https://aistudio.google.com/apikey
# Leave LLM_API_KEY unset and the chat shows a "not configured" message —
# everything else in the app still works.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash
